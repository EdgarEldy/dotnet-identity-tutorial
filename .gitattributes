# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# .NET / Visual Studio project files should always use CRLF.
*.sln text eol=crlf
*.csproj text eol=crlf merge=union

# Source and config files: force LF.
*.cs text eol=lf diff=csharp
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf

# Binary files: never diff, never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
