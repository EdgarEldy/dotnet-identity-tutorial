# Copy this file to .env (gitignored) and fill in real values before running
# docker compose up. docker-compose.yml reads every one of these.

API_PORT=8080

POSTGRES_HOST=postgres_main
POSTGRES_PORT=5432
POSTGRES_DB=dotnet_identity_tutorial
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

JWT_ISSUER=DotnetIdentityTutorial
JWT_AUDIENCE=DotnetIdentityTutorial
JWT_SIGNING_KEY=CHANGE_ME_placeholder_signing_key_for_tutorial_purposes_only
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

CORS_ALLOWED_ORIGIN=http://localhost:4200
